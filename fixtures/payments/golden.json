{
  "description": "Customer payment money rules (P21, U-132 to U-135) shared by the engine (packages/api/src/services/payment-compute.ts, packages/shared/fixtures/payment-golden.json) and the ClientLedger client (fixtures/payments/golden.json, byte-identical; the --demo engine runs every case). Synthetic. Every amount is a 2-place decimal string (whole cents, Q-P21t); invoices are keyed by number; accounts by role. Each case starts from an empty company with one client and the invoices listed; steps run in order. Keys marked engineOnly are not checked by the demo engine (its Payments Clearing also holds the sample company's payments).",
  "rules": {
    "amounts": "Every amount sent in is a decimal string with at most 2 places; more is 400 VALIDATION_ERROR. Overapply checks are exact: cash + discount + write-off on an invoice is at most its cent balance, no tolerance (Q-P21g).",
    "auto": "No applications sent: the amount fills open invoices oldest first (txnDate, then number, then id), each up to its balance; what is left is unapplied (a client credit).",
    "explicit": "Applications sent: rows not sent get 0.00; a row with amount null takes what is left of the amount, up to its balance, in date order; with no amount typed, null rows take their full balance and the amount is their sum (amountSource from_applications).",
    "discount": "discountAvailable = round2(total x percent / 100), half away from zero, capped at the cent balance, on or before discountDate (invoice date + discountDays); 0.00 after it or once a discount was taken. suggestDiscount: within the window and the row's payment is exactly the balance less discountAvailable (Q-P21c).",
    "shortfall": "A row paid more than 0.00 but less than its balance (cash + discount + write-off) is a shortfall of the rest; withinWriteOffLimit when the shortfall is at most the company's writeOffThreshold (false when none is set).",
    "balances": "contactBalanceAfter = before - amount - discounts - write-offs - deposit draws. Credits applied don't change it (already in A/R); a held deposit leaves it as before.",
    "bounce": "One dated returned_payment (Bounced payment): Cr the account holding the money (the deposit's bank, else depositTo, else Payments Clearing), Dr A/R amount + discounts + write-offs, Cr the discount and write-off accounts; every live application restored and marked reversed; remaining credit 0. A held deposit with draws: Dr A/R drawn + Dr Customer Deposits the rest. The bank fee is an expense in the same step."
  },
  "cases": [
    {
      "id": 1,
      "name": "mockup: 4,000.00 from Neosho Dental Group leaves 385.00 open on 1091",
      "company": {"writeOffThreshold": "1.00"},
      "invoices": [
        {"number": "1091", "date": "2026-10-05", "dueDate": "2026-11-04", "total": "4385.00"},
        {"number": "1095", "date": "2026-10-28", "dueDate": "2026-11-27", "total": "1260.00"}
      ],
      "otherPending": "6210.00",
      "steps": [
        {
          "op": "preview",
          "request": {"date": "2026-11-04", "amount": "4000.00"},
          "expect": {
            "amount": "4000.00", "amountSource": "typed",
            "payments": {"1091": "4000.00", "1095": "0.00"},
            "remaining": {"1091": "385.00", "1095": "1260.00"},
            "totals": {"amountDue": "5645.00", "applied": "4000.00", "discountsAndCredits": "0.00", "unapplied": "0.00"},
            "shortfalls": [{"invoice": "1091", "amount": "385.00", "withinWriteOffLimit": false}],
            "contactBalanceBefore": "5645.00", "contactBalanceAfter": "1645.00",
            "engineOnly": {"pendingDeposits": {"count": 2, "total": "10210.00"}}
          }
        },
        {
          "op": "receive",
          "request": {"date": "2026-11-04", "amount": "4000.00", "depositTo": "undeposited_funds", "applications": [{"invoice": "1091", "amount": "4000.00"}]},
          "expect": {
            "lines": [{"account": "undeposited_funds", "debit": "4000.00"}, {"account": "accounts_receivable", "credit": "4000.00"}],
            "invoices": {"1091": {"balanceDue": "385.00", "status": "partial"}, "1095": {"balanceDue": "1260.00", "status": "sent"}},
            "contactBalance": "1645.00"
          }
        }
      ]
    },
    {
      "id": 2,
      "name": "write-off: 4,384.25 on 1091 leaves 0.75, under the 1.00 limit, written off",
      "company": {"writeOffThreshold": "1.00"},
      "invoices": [
        {"number": "1091", "date": "2026-10-05", "dueDate": "2026-11-04", "total": "4385.00"},
        {"number": "1095", "date": "2026-10-28", "dueDate": "2026-11-27", "total": "1260.00"}
      ],
      "steps": [
        {
          "op": "preview",
          "request": {"date": "2026-11-04", "amount": "4384.25"},
          "expect": {
            "amount": "4384.25", "amountSource": "typed",
            "payments": {"1091": "4384.25", "1095": "0.00"},
            "totals": {"amountDue": "5645.00", "applied": "4384.25", "discountsAndCredits": "0.00", "unapplied": "0.00"},
            "shortfalls": [{"invoice": "1091", "amount": "0.75", "withinWriteOffLimit": true}],
            "contactBalanceBefore": "5645.00", "contactBalanceAfter": "1260.75"
          }
        },
        {
          "op": "receive",
          "request": {"date": "2026-11-04", "amount": "4384.25", "depositTo": "undeposited_funds", "applications": [{"invoice": "1091", "amount": "4384.25", "writeOffAmount": "0.75"}]},
          "expect": {
            "lines": [{"account": "undeposited_funds", "debit": "4384.25"}, {"account": "write_off", "debit": "0.75"}, {"account": "accounts_receivable", "credit": "4385.00"}],
            "invoices": {"1091": {"balanceDue": "0.00", "status": "paid"}},
            "contactBalance": "1260.00"
          }
        },
        {
          "op": "void",
          "expect": {"invoices": {"1091": {"balanceDue": "4385.00", "status": "sent"}}, "contactBalance": "5645.00"}
        }
      ]
    },
    {
