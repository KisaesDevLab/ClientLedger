          }
        },
        {
          "op": "receive",
          "request": {"date": "2026-11-09", "amount": "980.00", "depositTo": "undeposited_funds", "applications": [{"invoice": "2001", "amount": "980.00", "discountAmount": "20.00"}]},
          "expect": {
            "lines": [{"account": "undeposited_funds", "debit": "980.00"}, {"account": "sales_discount", "debit": "20.00"}, {"account": "accounts_receivable", "credit": "1000.00"}],
            "invoices": {"2001": {"balanceDue": "0.00", "status": "paid"}},
            "contactBalance": "2469.32"
          }
        }
      ]
    },
