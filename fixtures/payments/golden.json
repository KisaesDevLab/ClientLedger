      "invoices": [
        {"number": "3001", "date": "2026-10-01", "dueDate": "2026-10-31", "total": "0.01"},
        {"number": "3002", "date": "2026-10-02", "dueDate": "2026-11-01", "total": "999999.99"},
        {"number": "3003", "date": "2026-10-03", "dueDate": "2026-11-02", "total": "1.00"}
      ],
      "steps": [
        {"op": "preview", "request": {"date": "2026-11-04", "amount": "10.005"}, "expect": {"error": "VALIDATION_ERROR"}},
        {
          "op": "receive",
          "request": {"date": "2026-11-04", "amount": "1.01", "depositTo": "undeposited_funds", "applications": [{"invoice": "3003", "amount": "1.01"}]},
          "expect": {"error": "OVERAPPLIED"}
        },
        {
          "op": "preview",
          "request": {"date": "2026-11-04", "amount": "1000000.50"},
          "expect": {
            "payments": {"3001": "0.01", "3002": "999999.99", "3003": "0.50"},
            "totals": {"amountDue": "1000001.00", "applied": "1000000.50", "discountsAndCredits": "0.00", "unapplied": "0.00"},
            "shortfalls": [{"invoice": "3003", "amount": "0.50", "withinWriteOffLimit": false}],
            "contactBalanceAfter": "0.50"
          }
        }
      ]
    },
