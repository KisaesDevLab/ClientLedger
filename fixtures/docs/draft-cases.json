{
  "_comment": "A04 shared document-draft cases (plan section 6 T16, review S14). The demo engine (cl-ui company/demo/drafts.rs, WP-D) and the live engine (cl-api tests/contract_document_drafts.rs, WP-E; PENDING(U-95) until the pin bump) run the same cases and must give the same answers. WP-M froze the shape; later work packages only append cases to their own sections. Synthetic values only: no real names, files or amounts.",
  "_schema": {
    "case": "{ \"name\": unique snake_case, \"owner\": \"WP-D\" | \"WP-E\", \"why\": one line, \"steps\": [step, ...] }",
    "step": "{ \"op\": one of ops, \"args\": object, \"as\": optional label for later steps, \"expect\": { \"status\": HTTP status the engine answers, \"code\": engine error code or null, \"draft_status\": \"new\" | \"ready\" | \"failed\" | \"converted\" | \"discarded\" | null } }",
    "ops": [
      "upload_draft_file",
      "claim",
      "get",
      "list",
      "store_reading",
      "store_failure",
      "discard",
      "convert",
      "attach",
      "link_attachment",
      "plain_relink",
      "post_expense",
      "void",
      "set_closing_date",
      "search_amount"
    ],
    "refs": "args may name an earlier step's result by its label: \"$file1\" (an attachment id), \"$draft1.id\", \"$draft1.updatedAt\", \"$txn1.id\". Amounts are decimal strings; dates are YYYY-MM-DD.",
    "sections": "claim (D1 claim answers), store (readings and stale tokens), discard, convert (D2 convert answers), attach (U-95 a, T9), guard (U-95 b, T7), amount_filter (U-95 c)"
  },
  "claim": [
    {"name": "d_claim_new_draft", "owner": "WP-D", "why": "a draft file is claimed as a new draft", "steps": [
      {"op": "upload_draft_file", "args": {"content": "claim-a"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "get", "args": {"draft": "$d1.id"}, "expect": {"status": 200, "code": null, "draft_status": "new"}}
    ]},
    {"name": "d_claim_same_bytes_refused", "owner": "WP-D", "why": "the same bytes under another draft key are already claimed (Q-289)", "steps": [
      {"op": "upload_draft_file", "args": {"content": "claim-b"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "claim-b"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "claim", "args": {"file": "$f2", "kindHint": "card_charge", "key": "k2"}, "expect": {"status": 409, "code": "DOCUMENT_ALREADY_CLAIMED", "draft_status": null}}
    ]},
    {"name": "d_claim_after_discard_is_free", "owner": "WP-D", "why": "discarding frees the claim on the bytes", "steps": [
      {"op": "upload_draft_file", "args": {"content": "claim-c"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "discard", "args": {"draft": "$d1.id"}, "expect": {"status": 200, "code": null, "draft_status": "discarded"}},
      {"op": "upload_draft_file", "args": {"content": "claim-c"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f2", "kindHint": "bill", "key": "k2"}, "expect": {"status": 201, "code": null, "draft_status": "new"}}
    ]},
    {"name": "d_claim_filed_file_refused", "owner": "WP-D", "why": "a file already on a record is not a draft file", "steps": [
      {"op": "post_expense", "args": {"date": "2026-11-02", "amount": "18.40", "payFrom": "card"}, "as": "t1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "claim-d"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "link_attachment", "args": {"file": "$f1", "transaction": "$t1.id"}, "expect": {"status": 200, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "expect": {"status": 422, "code": "ATTACHMENT_NOT_DRAFT", "draft_status": null}}
    ]},
    {"name": "d_claim_key_replay_and_reuse", "owner": "WP-D", "why": "the same key replays the claim; another claim under it is refused", "steps": [
      {"op": "upload_draft_file", "args": {"content": "claim-e"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "claim-f"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "claim", "args": {"file": "$f2", "kindHint": "bill", "key": "k1"}, "expect": {"status": 422, "code": "IDEMPOTENCY_KEY_REUSED", "draft_status": null}}
    ]},
    {"name": "d_claim_converted_keeps_claim", "owner": "WP-D", "why": "a converted draft keeps its claim (N2)", "steps": [
      {"op": "upload_draft_file", "args": {"content": "claim-g"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "41.17", "key": "k2"}, "expect": {"status": 201, "code": null, "draft_status": "converted"}},
      {"op": "upload_draft_file", "args": {"content": "claim-g"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f2", "kindHint": "card_charge", "key": "k3"}, "expect": {"status": 409, "code": "DOCUMENT_ALREADY_CLAIMED", "draft_status": null}}
    ]},
    {"name": "d_claim_unknown_file", "owner": "WP-D", "why": "a file the company does not have is 404", "steps": [
      {"op": "claim", "args": {"file": "00000000-0000-4000-8000-0000000000aa", "kindHint": "bill", "key": "k1"}, "expect": {"status": 404, "code": null, "draft_status": null}}
    ]}
  ],
  "store": [
    {"name": "d_store_reading_then_stale", "owner": "WP-D", "why": "a reading stores once per token; the old token is stale", "steps": [
      {"op": "upload_draft_file", "args": {"content": "store-a"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "unknown", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "store_reading", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "docTotal": "12.50", "docDate": "2026-11-01", "docReference": "R-1", "vendor": "story"}, "as": "d1r", "expect": {"status": 200, "code": null, "draft_status": "ready"}},
      {"op": "store_reading", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "docTotal": "12.50"}, "expect": {"status": 409, "code": "STALE", "draft_status": null}},
      {"op": "store_reading", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1r.updatedAt", "kind": "bill", "docTotal": "12.50"}, "expect": {"status": 200, "code": null, "draft_status": "ready"}}
    ]},
    {"name": "d_store_failure_then_reading", "owner": "WP-D", "why": "a failed draft stays live and takes a reading", "steps": [
      {"op": "upload_draft_file", "args": {"content": "store-b"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "store_failure", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "reason": "unreadable"}, "as": "d1f", "expect": {"status": 200, "code": null, "draft_status": "failed"}},
      {"op": "store_reading", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1f.updatedAt", "kind": "bill"}, "expect": {"status": 200, "code": null, "draft_status": "ready"}}
    ]},
    {"name": "d_store_on_discarded_is_closed", "owner": "WP-D", "why": "a discarded draft takes no reading", "steps": [
      {"op": "upload_draft_file", "args": {"content": "store-c"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "discard", "args": {"draft": "$d1.id"}, "as": "d1x", "expect": {"status": 200, "code": null, "draft_status": "discarded"}},
      {"op": "store_reading", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1x.updatedAt", "kind": "bill"}, "expect": {"status": 409, "code": "DOCUMENT_DRAFT_CLOSED", "draft_status": null}}
    ]},
    {"name": "d_get_unknown_draft", "owner": "WP-D", "why": "an unknown draft is 404", "steps": [
      {"op": "get", "args": {"draft": "00000000-0000-4000-8000-0000000000ab"}, "expect": {"status": 404, "code": null, "draft_status": null}}
    ]},
    {"name": "d_list_counts_live_drafts", "owner": "WP-D", "why": "the queue's total counts live drafts only (Home count)", "steps": [
      {"op": "upload_draft_file", "args": {"content": "list-a"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "list-b"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "claim", "args": {"file": "$f2", "kindHint": "bill", "key": "k2"}, "as": "d2", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "discard", "args": {"draft": "$d2.id"}, "expect": {"status": 200, "code": null, "draft_status": "discarded"}},
      {"op": "list", "args": {"status": "new,ready,failed", "limit": 1}, "expect": {"status": 200, "code": null, "draft_status": null, "total": 1}}
    ]}
  ],
  "discard": [
    {"name": "d_discard_twice", "owner": "WP-D", "why": "discarding a discarded draft changes nothing", "steps": [
      {"op": "upload_draft_file", "args": {"content": "discard-a"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "discard", "args": {"draft": "$d1.id"}, "expect": {"status": 200, "code": null, "draft_status": "discarded"}},
      {"op": "discard", "args": {"draft": "$d1.id"}, "expect": {"status": 200, "code": null, "draft_status": "discarded"}}
    ]},
    {"name": "d_discard_converted_refused", "owner": "WP-D", "why": "a converted draft can't be discarded", "steps": [
      {"op": "upload_draft_file", "args": {"content": "discard-b"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "19.99", "key": "k2"}, "expect": {"status": 201, "code": null, "draft_status": "converted"}},
      {"op": "discard", "args": {"draft": "$d1.id"}, "expect": {"status": 409, "code": "DOCUMENT_DRAFT_CLOSED", "draft_status": null}}
    ]}
  ],
  "convert": [
    {"name": "d_convert_card_charge_moves_file", "owner": "WP-D", "why": "convert posts and moves the draft's file onto the record", "steps": [
      {"op": "upload_draft_file", "args": {"content": "convert-a"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "27.35", "vendor": "story", "reference": "RC-9001", "key": "k2"}, "expect": {"status": 201, "code": null, "draft_status": "converted", "file": "moved"}},
      {"op": "get", "args": {"draft": "$d1.id"}, "expect": {"status": 200, "code": null, "draft_status": "converted"}}
    ]},
    {"name": "d_convert_stale_token", "owner": "WP-D", "why": "convert with an old token is stale; the new token posts", "steps": [
      {"op": "upload_draft_file", "args": {"content": "convert-b"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "store_reading", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge"}, "as": "d1r", "expect": {"status": 200, "code": null, "draft_status": "ready"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "15.05", "key": "k2"}, "expect": {"status": 409, "code": "STALE", "draft_status": null, "file": "draft"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1r.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "15.05", "key": "k3"}, "expect": {"status": 201, "code": null, "draft_status": "converted", "file": "moved"}}
    ]},
    {"name": "d_convert_closed_period_password", "owner": "WP-D", "why": "423 first, a wrong password is refused, the right one posts under the same key", "steps": [
      {"op": "set_closing_date", "args": {"date": "2026-10-31"}, "expect": {"status": 200, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "convert-c"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-10-15", "amount": "73.40", "key": "kc"}, "expect": {"status": 423, "code": "TB_PERIOD_LOCKED", "draft_status": null, "file": "draft"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-10-15", "amount": "73.40", "closingPassword": "wrong", "key": "kc"}, "expect": {"status": 403, "code": "CLOSING_PASSWORD_INVALID", "draft_status": null}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-10-15", "amount": "73.40", "closingPassword": "right", "key": "kc"}, "expect": {"status": 201, "code": null, "draft_status": "converted", "file": "moved"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-10-15", "amount": "73.40", "closingPassword": "right", "key": "kc"}, "expect": {"status": 201, "code": null, "draft_status": "converted"}}
    ]},
    {"name": "d_convert_possible_duplicate_acknowledged", "owner": "WP-D", "why": "a posted expense of the vendor with the same total blocks until acknowledged", "steps": [
      {"op": "post_expense", "args": {"date": "2026-11-01", "amount": "63.18", "vendor": "story", "payFrom": "card"}, "as": "t1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "convert-d"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-02", "amount": "63.18", "vendor": "story", "key": "k2"}, "expect": {"status": 409, "code": "POSSIBLE_DUPLICATE", "draft_status": null, "file": "draft"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-02", "amount": "63.18", "vendor": "story", "acknowledge": ["$t1.id"], "key": "k3"}, "expect": {"status": 201, "code": null, "draft_status": "converted"}}
    ]},
    {"name": "d_convert_reference_duplicate", "owner": "WP-D", "why": "the same normalized reference blocks whatever the total (INV-00123 = inv123)", "steps": [
      {"op": "upload_draft_file", "args": {"content": "convert-e1"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "convert-e2"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "bill", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
