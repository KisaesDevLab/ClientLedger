      {"op": "convert", "args": {"draft": "$d2.id", "expectedUpdatedAt": "$d2.updatedAt", "kind": "bill", "date": "2026-11-03", "amount": "999.00", "vendor": "story", "reference": "inv123", "key": "k4"}, "expect": {"status": 409, "code": "POSSIBLE_DUPLICATE", "draft_status": null}}
    ]},
