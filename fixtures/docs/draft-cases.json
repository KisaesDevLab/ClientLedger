    {"name": "d_convert_key_replay_and_reuse", "owner": "WP-D", "why": "the same key replays (S3); another body under it is refused; a new key after the convert is closed (T1)", "steps": [
      {"op": "upload_draft_file", "args": {"content": "convert-h1"}, "as": "f1", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "upload_draft_file", "args": {"content": "convert-h2"}, "as": "f2", "expect": {"status": 201, "code": null, "draft_status": null}},
      {"op": "claim", "args": {"file": "$f1", "kindHint": "card_charge", "key": "k1"}, "as": "d1", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "claim", "args": {"file": "$f2", "kindHint": "card_charge", "key": "k2"}, "as": "d2", "expect": {"status": 201, "code": null, "draft_status": "new"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "36.90", "key": "kx"}, "expect": {"status": 201, "code": null, "draft_status": "converted"}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "36.90", "key": "kx"}, "expect": {"status": 201, "code": null, "draft_status": "converted"}},
      {"op": "convert", "args": {"draft": "$d2.id", "expectedUpdatedAt": "$d2.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "36.90", "key": "kx"}, "expect": {"status": 422, "code": "IDEMPOTENCY_KEY_REUSED", "draft_status": null}},
      {"op": "convert", "args": {"draft": "$d1.id", "expectedUpdatedAt": "$d1.updatedAt", "kind": "card_charge", "date": "2026-11-03", "amount": "36.90", "key": "ky"}, "expect": {"status": 409, "code": "DOCUMENT_DRAFT_CLOSED", "draft_status": null}}
