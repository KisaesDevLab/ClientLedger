{
  "description": "Sales tax money rules (P23, U-147 to U-154) shared by the engine (packages/shared/fixtures/sales-tax-golden.json) and the ClientLedger client (fixtures/sales_tax/golden.json, byte-identical; the --demo engine runs every case not marked engineOnly). Synthetic. Amounts are 2-place decimal strings, rates 6-place fractions. Accounts are keyed by role, documents by name, sales taxes, codes and clients by name.",
  "rules": [
    "One sales tax (an item or a group) per document: the document's, else the client's default, else the company's (Q-P23d). Tax = round2(taxable base x combined rate), half away from zero, once per document.",
    "Line tax and group member tax: the document tax allocated by largest remainder (allocateCents) over line amount x rate and base x member rate. A negative base on a document with a positive subtotal taxes 0.00.",
    "Line tax code: the line's, else the client's non-taxable code, else the item's code, else the item's taxable flag (Tax / Non). Non-taxable lines add to the nonTaxable column by code under every item of the document's sales tax.",
    "Accrual collected = sale rows by document date. Cash collected (Q-P23e): settlement k of invoice i, ordered by (effective date, created, id), takes share_k = round2(T_i x P_k / total_i) - round2(T_i x P_(k-1) / total_i), P = cumulative cash + discounts (never write-offs, Q-SPF3); sales receipts and daily sales count on their date.",
    "Cash basis is pure cash (Q-SPF1): money received and not applied is income in the Unapplied receipts account; its tax is recognised when it is applied, at the apply date (Q-P23y). No A/R and no Customer Deposits on the cash Balance Sheet.",
    "SSUTA (Q-P23m, Q-SPF3, Q-SPF6): when the company switch is on, an early-payment discount D and a write-off W of an invoice carry tax shares d and w (the accrual running total over c + D + W split by allocateCents); discount rows count on both bases, bad-debt and recovery rows on accrual only. Off: as before (no tax share).",
    "owedAtEnd = cumulative collected + discounts + badDebts + recoveries + adjustments - paid - openingPaid. Pay Sales Tax owed through a date = rows on the company basis dated on or before it + all live adjustments - all live paid and opening lines (S1).",
    "Cases 1-10 share the monett seed and run in one company in the order of seeds.monett.chain; every other case starts from an empty company with its own seed. Keys and steps marked engineOnly are not checked by the demo engine."
  ],
  "seeds": {
    "monett": {
      "chain": [1, 2, 3, 4, 5, 6, 8, 7, 9, 10],
      "ssuta": true,
      "basis": "accrual",
      "accounts": {
        "operating_checking": { "name": "Operating checking", "type": "bank" },
        "income": { "name": "Sales", "type": "revenue" },
        "sales_tax_discounts": { "name": "Sales tax discounts", "type": "other_revenue" },
        "sales_discounts": { "name": "Sales discounts", "type": "revenue" },
        "bad_debts": { "name": "Bad debts", "type": "expense" },
        "supplies": { "name": "Supplies", "type": "expense" },
        "bill_discounts": { "name": "Bill discounts", "type": "other_revenue" }
      },
      "settings": { "writeOffAccount": "bad_debts", "writeOffThreshold": "200.00", "salesDiscountAccount": "sales_discounts" },
      "agencies": [
        { "name": "Sample State Revenue Dept." },
        { "name": "Sample City Revenue Office" }
      ],
      "salesTaxes": [
        { "kind": "item", "name": "State", "rate": "0.042250", "agency": "Sample State Revenue Dept." },
        { "kind": "item", "name": "Springfield", "rate": "0.088750", "agency": "Sample State Revenue Dept." },
        { "kind": "item", "name": "City", "rate": "0.038750", "agency": "Sample City Revenue Office" },
        { "kind": "group", "name": "Monett", "members": ["State", "City"] }
      ],
      "companyDefault": "Monett",
      "codes": [
        { "code": "Tax", "name": "Taxable", "taxable": true, "system": true },
        { "code": "Non", "name": "Non-taxable", "taxable": false, "system": true },
        { "code": "Res", "name": "Resale", "taxable": false }
      ],
      "items": [
        { "name": "Install labor", "account": "income", "taxCode": "Non" },
        { "name": "Shrubs 3 gal", "account": "income", "taxCode": "Tax" },
        { "name": "Mulch yard", "account": "income", "taxCode": "Tax" },
        { "name": "Perennials", "account": "income", "taxCode": "Tax" },
        { "name": "Plants", "account": "income", "taxCode": "Tax" }
      ],
      "clients": [
        { "name": "Hollister Family" },
        { "name": "Ozark Outfitters", "salesTax": "Springfield" },
        { "name": "Cedar Hollow Supply", "salesTax": "Springfield", "taxCode": "Res" },
        { "name": "Briar Creek Co-op", "salesTax": "Springfield", "taxCode": "Res" },
        { "name": "Pine Bluff Nursery", "salesTax": "Springfield", "taxCode": "Res" }
      ]
