          { "itemType": "non_inventory", "quantity": "6", "unitPrice": "45.00", "unitPriceSource": "price_level", "discountPercent": null, "amount": "270.00", "taxRate": "0.0810", "taxAmount": "21.87" },
          { "itemType": "service", "quantity": "18", "unitPrice": "65.00", "unitPriceSource": "input", "discountPercent": null, "amount": "1170.00", "taxRate": "0.0000", "taxAmount": "0.00" }
