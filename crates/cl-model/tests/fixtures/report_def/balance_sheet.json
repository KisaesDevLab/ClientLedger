{
  "schemaVersion": 1,
  "kind": "builder",
  "title": "Balance Sheet",
  "dates": { "mode": "asOf", "preset": "end_of_last_month" },
  "basis": "accrual",
  "adjusting": "include",
  "columns": { "detailFields": [], "compare": [], "headers": {} },
  "nodes": [
    {
      "type": "section",
      "id": "assets",
      "caption": "Assets",
      "source": "gl",
      "measure": "balance",
      "filters": [{ "field": "account_type", "op": "in", "values": ["asset"] }],
      "groupBy": [{ "key": "account" }],
      "display": "expandable",
      "defaultExpanded": false,
      "showTotal": true,
      "totalCaption": "Total Assets",
      "hideZero": true
    },
    {
      "type": "group",
      "id": "le",
      "caption": "Liabilities and Equity",
      "showTotal": true,
      "children": [
        {
          "type": "section",
          "id": "liabilities",
          "caption": "Liabilities",
          "source": "gl",
          "measure": "balance",
          "filters": [{ "field": "account_type", "op": "in", "values": ["liability"] }],
          "groupBy": [{ "key": "account" }],
          "display": "summary",
          "defaultExpanded": false,
          "showTotal": true,
          "hideZero": true
        },
        {
          "type": "section",
          "id": "equity",
          "caption": "Equity",
          "source": "gl",
          "measure": "balance",
          "filters": [
            { "field": "account_type", "op": "in", "values": ["equity"] },
            { "field": "tag", "op": "is_none" }
          ],
          "groupBy": [{ "key": "account" }],
          "display": "summary",
          "defaultExpanded": false,
          "showTotal": true,
          "hideZero": false,
          "earnings": "balance_sheet"
        }
      ]
    }
  ]
}